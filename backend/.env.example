# Copy to .env and fill in. .env is gitignored; never commit a real token.

# WaniKani personal access token — https://www.wanikani.com/settings/personal_access_tokens
# Read-only is enough for the dashboard. Starting lessons and submitting
# reviews additionally need the assignments:start and reviews:create scopes.
wanikani_apikey=

# Postgres. Empty is valid: the API still serves every read-only route
# straight from WaniKani, it just cannot cache or derive streaks.
# Use your provider's POOLER endpoint when running on Lambda.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# local | staging | production. Anything other than "local" locks down CORS.
ENVIRONMENT=local
LOG_LEVEL=INFO
