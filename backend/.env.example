# Copy to .env and fill in. .env is gitignored; never commit a real token.

# WaniKani personal access token — https://www.wanikani.com/settings/personal_access_tokens
# Read-only is enough for the dashboard. Starting lessons and submitting
# reviews additionally need the assignments:start and reviews:create scopes.
wanikani_apikey=

# Postgres. Empty is valid: the API still serves every read-only route
# straight from WaniKani, it just cannot cache or derive streaks.
# Use your provider's POOLER endpoint when running on Lambda.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Alembic connects with this instead, when set. Providers give you two
# endpoints: the pooler above for the app, and a DIRECT one for schema changes.
# DDL through a transaction-mode pooler is unreliable, so migrations want the
# direct endpoint. Unset falls back to DATABASE_URL, which is right locally.
# DATABASE_MIGRATION_URL=postgresql://user:password@direct-host/dbname?sslmode=require

# Vision extraction for photo import — https://console.anthropic.com/
# Empty means the feature is off: uploads are refused with a 503 rather than
# accepted and silently never processed.
# ANTHROPIC_API_KEY=

# How long to wait on one page extraction. Keep this below the app's polling
# window, or the client gives up on work the server is still doing.
# VISION_TIMEOUT_SECONDS=120

# local | staging | production. Anything other than "local" locks down CORS.
ENVIRONMENT=local
LOG_LEVEL=INFO
