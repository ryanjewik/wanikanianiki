# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Local archives
*.zip

# Claude Code local settings
.claude/settings.local.json

# IDE
.idea/
.vscode/

# OS
Thumbs.db
Desktop.ini

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Terraform (infra/). The lock file is committed; state, provider caches and
# variable files are not — state can hold resource details worth keeping local.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# local env files — .env holds the WaniKani token, never commit it
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders (Expo prebuild output). /android is a prebuild that
# ran from the repo root rather than mobile/; regenerate with `npx expo prebuild`.
/mobile/ios
/mobile/android
/android

# Gradle output inside local native modules (mobile/modules/*). The prebuild's
# android/ is ignored above, but each module builds in its own folder too.
/mobile/modules/*/android/build/
/mobile/modules/*/android/.gradle/
