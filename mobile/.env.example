# Copy to mobile/.env. The mobile app never holds the WaniKani token —
# that lives in backend/.env and never leaves the server.

# Points the app at your backend. Leave unset to run entirely on the
# fixtures in src/data/fixtures.ts.
#
# The right host depends on where the app is running, because an emulator has
# its own network stack and "localhost" means the emulator itself:
#   Android emulator (Android Studio): http://10.0.2.2:8000 — the alias for
#     the host's loopback, so uvicorn on 127.0.0.1 is reachable as-is
#   Android emulator (Genymotion):     http://10.0.3.2:8000
#   iOS simulator:                     http://localhost:8000 — shares the host
#   Physical device on the same Wi-Fi: http://<your-LAN-ip>:8000, and start
#     uvicorn with --host 0.0.0.0 so it accepts more than loopback
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
